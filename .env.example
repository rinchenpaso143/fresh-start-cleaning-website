# Port the server runs on (most hosts set this automatically — leave as is)
PORT=3000

# --- Email notifications (optional but recommended) ---
# If you use Gmail: turn on 2-Step Verification, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use that as SMTP_PASS
# (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Where enquiry notifications get sent (can be the same as SMTP_USER)
TO_EMAIL=hello@freshstartcleaningadelaide.com.au

# --- Admin access ---
# A password of your choosing, used to view saved leads at /api/leads?key=...
ADMIN_KEY=choose-a-secret-password
